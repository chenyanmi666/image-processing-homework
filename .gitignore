# --- Python 构建/缓存产物 ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- 虚拟环境（不提交，由使用者本地创建）---
.venv/
venv/
env/
ENV/

# --- Cline / Kilo Code 工具缓存（注意：项目规则目录 .clinerules 必须保留入库）---
.cline/
.kilo/

# --- 编辑器与系统文件 ---
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# --- 日志与临时文件 ---
*.log
*.tmp
~$*

# --- 敏感信息（禁止入库）---
.env
.env.*
*.key
*.pem
secrets.json
